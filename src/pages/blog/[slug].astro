---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BlogCard from "../../components/blog/BlogCard.astro";
import BlogTag from "../../components/blog/BlogTag.astro";
import Corners from "../../components/ui/Corners.astro";
import Separator from "../../components/ui/Separator.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort((a, b) => a.data.order - b.data.order);
  // "More Blogs" = the first three other posts in list order, as in the template.
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, more: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  more: CollectionEntry<"blog">[];
}

const { post, more } = Astro.props;
const { title, cover, author, avatar, date } = post.data;
const { Content } = await render(post);
const published = date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Layout title={`${title} - My Framer Site`} image={cover}>
  <section class="flex w-full flex-col pt-20">
    <div class="edge edge-x edge-b relative flex flex-col items-center overflow-hidden px-5 py-15 md:px-10 md:py-20">
      <div class="relative z-2 flex w-full max-w-[800px] flex-col items-center gap-6 text-center">
        <BlogTag post={post} />
        <h1 class="type-h2 text-ink">{title}</h1>
        <div class="flex items-center gap-2 text-sm leading-[1.4] text-body">
          <img src={avatar} alt="" class="size-6 rounded-full object-cover" />
          <span>{author}</span>
          <span class="mx-0.5 size-1 rounded-full bg-body"></span>
          <time datetime={date.toISOString().slice(0, 10)}>{published}</time>
        </div>
      </div>
      <Corners />
    </div>
    <div class="edge edge-r edge-b relative w-full lg:edge-l">
      <img src={cover} alt="" class="aspect-[1360/729] w-full object-cover" />
    </div>
  </section>
  <Separator />

  <article class="edge edge-x edge-b relative flex w-full justify-center px-5 py-15 md:px-10 md:py-20">
    <div class="article w-full max-w-[832px]">
      <Content />
    </div>
  </article>
  <Separator />

  <section class="flex w-full flex-col">
    <div class="edge edge-x edge-b relative flex flex-col overflow-hidden px-5 py-15 md:px-10 md:py-20">
      <h2 class="type-h2 text-ink">More Blogs</h2>
      <Corners />
    </div>
    <div class="grid w-full lg:grid-cols-3">
      {more.map((p) => <BlogCard post={p} more />)}
    </div>
  </section>
</Layout>

