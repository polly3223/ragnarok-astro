---
import AuthField from "../components/auth/AuthField.astro";
import AuthShell from "../components/auth/AuthShell.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <AuthShell height={494}
    title="Sign In"
    lead="Access your account"
    card={{ title: "Don't have an account yet?", href: "/sign-up", label: "Sign Up" }}
    social
    submit="Sign In"
    forgot="link"
  >
    <AuthField label="Email" name="email" placeholder="Email" />
    <AuthField label="Password" name="password" type="password" placeholder="Password" />
  </AuthShell>
</Layout>
