---
import AuthField from "../components/auth/AuthField.astro";
import AuthShell from "../components/auth/AuthShell.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <AuthShell height={520} submit="Save Changes">
    <Fragment slot="intro">
      <img src="/images/auth/avatar.png" alt="" class="size-16 rounded-[26%] border border-[#dddde4] object-cover" />
      <span></span>
    </Fragment>
    <!-- FrameAuth's signed-out account widgets render empty but still take up space in the template. -->
    <Fragment slot="after">
      <span class="h-6"></span>
      <span></span>
    </Fragment>
    <AuthField label="Name" name="name" placeholder="Name" />
    <AuthField label="Email" name="email" placeholder="Email" />
  </AuthShell>
</Layout>
