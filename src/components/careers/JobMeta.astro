---
// "Location • Type • Salary" line on job cards.
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2 type-body">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span class="size-1 rounded-full bg-body" />}
        <span>{item}</span>
      </>
    ))
  }
</div>
