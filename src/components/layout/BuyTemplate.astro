---
// Floating "LAUNCH IN HOURS / Buy Template" card (bottom right).
import Button from "../ui/Button.astro";
---

<div data-buy class="fixed right-[23px] bottom-16 z-10">
  <div class="relative flex w-40 flex-col rounded-[5px] p-1 shadow-card">
    <div class="absolute inset-0 -top-[23px] z-1 flex flex-col items-center overflow-hidden rounded-[5px] bg-white pt-0.5">
      <div class="flex h-6 w-full items-center justify-center rounded-[10px] bg-white">
        <p class="shimmer font-grotesk text-sm leading-[1.1] tracking-[-0.01em] whitespace-pre text-ink">LAUNCH IN HOURS</p>
      </div>
    </div>
    <Button
      href="https://contra.com/payment-link/224G7IWU-ragnarok-ai-agent-framer-template"
      label="Buy Template"
      size="small"
      newTab
      full
      class="z-3"
    />
  </div>
</div>
