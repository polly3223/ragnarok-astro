---
import TextLink from "../ui/TextLink.astro";

const navigate = [
  [
    { href: "/", label: "Home" },
    { href: "/about", label: "About" },
  ],
  [
    { href: "/pricing", label: "Pricing" },
    { href: "/contact", label: "Contact" },
  ],
  [
    { href: "/blog", label: "Blog" },
    { href: "/careers", label: "Career" },
  ],
];
// Placeholder hrefs: the template points the brand's socials at its author's personal profiles.
const socials = [
  { label: "X", icon: "/images/social/x.png" },
  { label: "Instagram", icon: "/images/social/instagram.png" },
  { label: "LinkedIn", icon: "/images/social/linkedin.png" },
];
const makers = [
  { href: "https://x.com/BreejeAnadkat", label: "Breeje" },
  { href: "https://www.linkedin.com/in/sbiswas29/", label: "Shubham" },
  { href: "https://x.com/AnasKaratela7", label: "Anas" },
];
// Parallax strength of each outlined wordmark layer (px at the viewport edge) and its smoothing.
const layers = [
  [240, 50],
  [180, 40],
  [140, 30],
  [100, 20],
  [60, 10],
  [30, 0],
];
const heading = "type-label whitespace-pre text-ink";
const column = "edge relative flex flex-col gap-6 p-5 md:p-10";
---

<footer class="mx-auto w-full max-w-[1920px] px-5 md:px-10">
  <div class="flex flex-col bg-page">
    <div class="edge edge-b relative flex flex-col overflow-hidden lg:h-[281px] lg:flex-row lg:items-center">
      <div class:list={[column, "edge-x edge-b lg:h-full lg:flex-1 lg:edge-b-0"]}>
        <h2 class={heading}>NAVIGATE</h2>
        {
          navigate.map(([first, second]) => (
            <div class="flex gap-5">
              <div class="w-[46px]">{first && <TextLink {...first} />}</div>
              {second && <TextLink {...second} />}
            </div>
          ))
        }
      </div>
      <div class:list={[column, "edge-x edge-b lg:h-full lg:flex-1 lg:edge-b-0 lg:edge-l-0"]}>
        <h2 class={heading}>GET IN TOUCH</h2>
        <div class="flex gap-5">
          {/* The template's placeholder phone numbers and email are not linked, so nobody real is reached. */}
          <div class="w-[122px]"><TextLink href="#" label="+1 (312) 553-6703" /></div>
          <TextLink href="#" label="+1 (703) 412-5927" />
        </div>
        <TextLink href="#" label="support@ragnarok.ai" />
        <TextLink href="https://maps.app.goo.gl/LzvwJFtkArZyLEG59" label="800 W El Camino Real, CA 94040" newTab />
      </div>
      <div class="flex flex-col lg:flex-1">
        <div class:list={[column, "edge-x lg:edge-l-0"]}>
          <h2 class={heading}>FOLLOW US</h2>
          <div class="flex items-center gap-4">
            {
              socials.map((s) => (
                <a href="#" aria-label={s.label}>
                  <img src={s.icon} alt="" class="size-5" />
                </a>
              ))
            }
          </div>
        </div>
        <div class:list={[column, "edge-t edge-x lg:edge-l-0"]}>
          <h2 class={heading}>LEGAL</h2>
          <div class="flex gap-5">
            <TextLink href="/legal/privacy-policy" label="Privacy Policy" />
            <TextLink href="/legal/terms-of-service" label="Terms of Service" />
          </div>
        </div>
      </div>
    </div>

    <div data-parallax class="edge edge-x relative hidden flex-col items-center justify-end overflow-hidden px-10 pt-[140px] md:flex">
      <div class="relative w-full">
        {
          layers.map(([distance, smoothing], i) => (
            <div
              data-parallax-layer={distance}
              data-smoothing={smoothing}
              class:list={["w-full overflow-clip", i ? "absolute -bottom-px -left-[3px]" : "relative"]}
              style={`z-index: ${i + 1}`}
            >
              <svg viewBox={i ? "0 0 1029 131" : "0 0 1033 131"} class="block w-full select-none" aria-hidden="true">
                <foreignObject width="100%" height="100%" class="overflow-visible">
                  <p class="font-grotesk text-[164px] leading-[0.8] font-medium whitespace-pre text-page [-webkit-text-stroke:1px_var(--color-primary)]">
                    RAGNAROK.AI
                  </p>
                </foreignObject>
              </svg>
            </div>
          ))
        }
      </div>
    </div>
    <div class="edge edge-x relative flex flex-col items-center justify-end overflow-hidden p-5 md:hidden">
      <svg viewBox="0 0 1033 131" class="block w-full select-none" aria-hidden="true">
        <foreignObject width="100%" height="100%" class="overflow-visible">
          <p class="font-grotesk text-[164px] leading-[0.8] font-medium whitespace-pre text-[#dddde4]">RAGNAROK.AI</p>
        </foreignObject>
      </svg>
    </div>

    <div class="edge edge-b relative flex overflow-hidden">
      <div
        class="edge edge-t edge-x relative flex flex-1 flex-col gap-6 p-5 md:flex-row md:items-start md:justify-between md:p-10"
      >
        <p class="type-small whitespace-pre text-body">© 2025 Ragnarok AI. All rights reserved</p>
        <div class="flex items-center gap-2">
          <p class="type-small whitespace-pre text-body">Made by:</p>
          <div class="flex items-center gap-1">
            {
              makers.map((m, i) => (
                <>
                  {i > 0 && <span class="size-1 rounded-full bg-ink/20" />}
                  <TextLink {...m} dark newTab />
                </>
              ))
            }
          </div>
        </div>
        <div class="flex w-[264px] items-center gap-1 md:justify-end">
          <p class="type-small whitespace-pre text-body">Built in</p>
          <TextLink href="https://framer.link/breeje83" label="Framer" dark newTab />
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import "../../scripts/parallax.ts";
</script>
