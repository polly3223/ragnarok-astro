---
// FrameAuth-style input: grey label, hairline inset ring that turns blue on focus, optional eye toggle.
import Eye from "../../icons/eye.svg";

interface Props {
  label: string;
  name: string;
  type?: "text" | "email" | "password";
  placeholder: string;
}

const { label, name, type = "text", placeholder } = Astro.props;
---

<label class="flex flex-col">
  <span class="pb-2 text-base leading-none text-[#666]">{label}</span>
  <span class="relative mt-1 flex">
    <input
      type={type}
      name={name}
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      class="h-[53px] w-full rounded-lg bg-white p-4 font-onest text-base leading-none text-ink shadow-[inset_0_0_0_1px_#e7e7e7] outline-none placeholder:text-[#1f1f3280] focus:shadow-[inset_0_0_0_1px_var(--color-primary)]"
    />
    {
      type === "password" && (
        <button type="button" data-reveal-password aria-label="Show password" class="absolute inset-y-0 right-0 flex cursor-pointer items-center p-4 text-[#999]">
          <Eye class="size-6" />
        </button>
      )
    }
  </span>
</label>
