---
// Labelled form control in the template's style (text input, textarea or select).
interface Props {
  label: string;
  name: string;
  type?: "text" | "email" | "password" | "textarea" | "select";
  placeholder?: string;
  options?: string[];
  required?: boolean;
  autocomplete?: string;
  class?: string;
}

const { label, name, type = "text", placeholder, options = [], required = false, autocomplete, class: className } = Astro.props;
const control = "w-full bg-transparent px-4 py-3 text-sm leading-[1.2] text-[#1f1f32] outline-none placeholder:text-[#1f1f3280]";
---

<label class:list={["flex w-full flex-col gap-2", className]}>
  <span class="type-label text-ink">{label}</span>
  <span class="edge edge-all relative flex w-full rounded-[4px] bg-white focus-within:[--edge-color:#09f]">
    {
      type === "textarea" ? (
        <textarea name={name} placeholder={placeholder} required={required} class:list={[control, "h-[140px] resize-y md:h-[85px]"]} />
      ) : type === "select" ? (
        <>
          <select name={name} required={required} class:list={[control, "appearance-none pr-10 invalid:text-[#1f1f3280]"]}>
            <option value="" disabled selected hidden>{placeholder}</option>
            {options.map((option) => <option>{option}</option>)}
          </select>
          <svg viewBox="0 0 16 16" aria-hidden="true" class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2">
            <path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </>
      ) : (
        <input type={type} name={name} placeholder={placeholder} required={required} autocomplete={autocomplete} class={control} />
      )
    }
  </span>
</label>
