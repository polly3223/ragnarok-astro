---
// Icon + title + one-liner card (About values, Careers perks); borders come from the caller.
interface Props {
  icon: string;
  title: string;
  text: string;
  class?: string;
}

const { icon, title, text, class: className } = Astro.props;
---

<div class:list={["edge relative flex flex-col gap-8 p-10", className]}>
  <img src={icon} alt="" class="size-8" />
  <div class="flex flex-col gap-2">
    <h3 class="font-grotesk text-xl leading-[1.2] font-medium tracking-[-0.04em] text-ink">{title}</h3>
    <p class="type-body">{text}</p>
  </div>
</div>
